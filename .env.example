# 管理画面のログインID・パスワード（本番では必ず設定してください）
# 未設定のときは開発用の初期値：ID 1001 ／ パスワード orbit-demo
ADMIN_ID=1001
ADMIN_PASSWORD=

# 本番（Neon）を使うときだけ設定。空ならローカルのDB（.data フォルダ）を使います
DATABASE_URL=

# ポータル・公式サイトのパスワードやAPIキーを暗号化する鍵（32文字以上のランダムな文字列）
# 開発中は空でも動きます（仮の鍵）。本番では必ず設定し、変えないでください（変えると保存済みのキーが読めなくなります）
ORBIT_SECRET_KEY=
